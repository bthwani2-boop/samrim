{
  "name": "repository-ci",
  "root": ".github",
  "projectType": "library",
  "tags": [
    "scope:repository-ci",
    "type:tool"
  ],
  "targets": {
    "runtime-integration": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/run-ci-runtime-proof.mjs"
      }
    },
    "execution-proof-system": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/REPOSITORY-STRUCTURE.md",
        "{workspaceRoot}/knowledge.sources.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/.github/ci-performance-budgets.json",
        "{workspaceRoot}/tools/dev/runtime-proof/**/*",
        "{workspaceRoot}/tools/dev/verify-dsh-runtime-core.mjs",
        "{workspaceRoot}/tools/dev/verify-dsh-location-runtime.mjs",
        "{workspaceRoot}/tools/dev/verify-local-candidate.ps1",
        "{workspaceRoot}/tools/dev/run-ci-runtime-proof.mjs",
        "{workspaceRoot}/tools/dev/verify-execution-proof-system.mjs",
        "{workspaceRoot}/tools/dev/execution-proof-system.mjs",
        "{workspaceRoot}/tools/dev/verify-agent-knowledge-contract.mjs",
        "{workspaceRoot}/tools/dev/verify-ci-exact-sha.mjs",
        "{workspaceRoot}/tools/dev/build-ci-image.mjs",
        "{workspaceRoot}/tools/dev/run-ci-command.mjs",
        "{workspaceRoot}/tools/dev/capture-ci-failure.mjs",
        "{workspaceRoot}/tools/dev/ci-failure-diagnostics.mjs",
        "{workspaceRoot}/tools/dev/ci-failure-diagnostics.test.mjs",
        "{workspaceRoot}/tools/dev/record-ci-external-result.mjs",
        "{workspaceRoot}/tools/dev/enforce-ci-batch.mjs",
        "{workspaceRoot}/tools/dev/verify-pr-policy.mjs",
        "{workspaceRoot}/tools/dev/verify-pr-policy.test.mjs",
        "{workspaceRoot}/tools/dev/report-ci-performance.mjs",
        "{workspaceRoot}/tools/dev/verify-cache-contracts.mjs",
        "{workspaceRoot}/tools/dev/hash-control-panel-secret-input.mjs",
        "{workspaceRoot}/tools/mobile/hash-mobile-secret-input.mjs",
        {
          "runtime": "node --version"
        }
      ],
      "options": {
        "command": "node tools/dev/verify-execution-proof-system.mjs"
      }
    }
  }
}
