{
  "name": "repository-ci",
  "root": ".github",
  "projectType": "library",
  "tags": [
    "scope:repository-ci",
    "type:tool"
  ],
  "targets": {
    "runtime-integration": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/run-ci-runtime-proof.mjs"
      }
    },
    "execution-proof-system": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/tools/dev/verify-local-candidate.ps1",
        "{workspaceRoot}/tools/dev/run-ci-runtime-proof.mjs",
        "{workspaceRoot}/tools/dev/verify-execution-proof-system.mjs",
        {
          "runtime": "node --version"
        }
      ],
      "options": {
        "command": "node tools/dev/verify-execution-proof-system.mjs"
      }
    }
  },
  "implicitDependencies": [
    "identity-backend",
    "dsh-backend",
    "wlt-backend",
    "control-panel",
    "infra",
    "workspace-tooling"
  ]
}
