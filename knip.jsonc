{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "infra/setup-env.mjs"
      ]
    }
  },
  "ignore": [
    // Expo reads these fingerprint files by convention, not a static import.
    "apps/{captain,customer,merchant}/fingerprint.config.js",
    // Type declaration for the CJS Expo config helper.
    "tools/mobile/define-bthwani-expo-app.d.cts",
    // Metro/Web resolve these platform variants from "./animations".
    "packages/tamagui-config/src/animations.{native,web}.ts",
    // BEGIN RETAINED MERCHANT PRESENTATION PLACEHOLDERS
    // Explicit user decision: preserve these 18 unconnected, presentation-only modules.
    // Scoped exceptions, NOT runtime routes or implemented capabilities.
    // Checked by verify-application-boundaries.test.mjs. Remove each exemption
    // when its module gains a real consumer or owner-backed implementation.
    "apps/merchant/src/features/catalog/inventory-summary.tsx",
    "apps/merchant/src/features/catalog/product-media.tsx",
    "apps/merchant/src/features/catalog/products-screen.tsx",
    "apps/merchant/src/features/employees/employee-access.tsx",
    "apps/merchant/src/features/finance/earnings-summary.tsx",
    "apps/merchant/src/features/finance/payout-recipients.tsx",
    "apps/merchant/src/features/finance/wallet-screen.tsx",
    "apps/merchant/src/features/marketing/store-banners.tsx",
    "apps/merchant/src/features/marketing/store-design.tsx",
    "apps/merchant/src/features/marketing/store-reels.tsx",
    "apps/merchant/src/features/notifications/order-alert-monitor.tsx",
    "apps/merchant/src/features/orders/order-conversation.tsx",
    "apps/merchant/src/features/orders/order-preparation.tsx",
    "apps/merchant/src/features/orders/orders-screen.tsx",
    "apps/merchant/src/features/stores/operating-hours.tsx",
    "apps/merchant/src/features/stores/store-scope.tsx",
    "apps/merchant/src/features/stores/store-selector.tsx"
    // END RETAINED MERCHANT PRESENTATION PLACEHOLDERS
  ],
  "ignoreBinaries": [
    // Expo and the npm "build" script are invoked by GitHub Actions.
    "expo",
    "build"
  ]
}
