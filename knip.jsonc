{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/dev/js-deps.mjs",
        "tools/dev/verify-dsh-location-runtime.mjs",
        "tools/dev/build-ci-image.mjs",
        "tools/dev/check-go-format.mjs",
        "tools/dev/hash-control-panel-secret-input.mjs",
        "tools/dev/run-ci-runtime-proof.mjs",
        "tools/dev/runtime-proof/resolve.test.mjs",
        "tools/dev/runtime-proof/trusted-executables.test.mjs",
        "tools/dev/verify-agent-knowledge-contract.mjs",
        "tools/dev/verify-cache-contracts.mjs",
        "tools/dev/verify-doc-command-parity.mjs",
        "tools/dev/verify-doc-config-parity.mjs",
        "tools/dev/verify-dsh-baseline.mjs",
        "tools/dev/verify-dsh-runtime-core.mjs",
        "tools/dev/verify-go-workspace-sync.mjs",
        "tools/dev/verify-identity-migrations.mjs",
        "tools/dev/verify-identity-runtime.mjs",
        "tools/dev/verify-knowledge-references.mjs",
        "tools/dev/verify-knowledge-system.mjs",
        "tools/dev/verify-local-runtime-ownership.mjs",
        "tools/dev/verify-nx-project-tags.mjs",
        "tools/dev/verify-pr-policy.mjs",
        "tools/dev/verify-pr-policy.test.mjs",
        "tools/dev/verify-removed-human-domain-residue.mjs",
        "tools/dev/verify-repository-structure.mjs",
        "tools/dev/verify-secret-safety.mjs",
        "tools/dev/verify-workspace-dependencies.mjs",
        "tools/mobile/export-mobile-smoke.mjs",
        "tools/mobile/hash-mobile-secret-input.mjs",
        "tools/mobile/test-mobile-app.mjs"
      ]
    },
    "apps/app-captain": {
      "entry": ["index.js", "app/**/*.ts", "app/**/*.tsx", "app.config.ts"]
    },
    "apps/app-client": {
      "entry": ["index.js", "app/**/*.ts", "app/**/*.tsx", "app.config.ts"]
    },
    "apps/app-field": {
      "entry": ["index.js", "app/**/*.ts", "app/**/*.tsx", "app.config.ts"]
    },
    "apps/app-partner": {
      "entry": ["index.js", "app/**/*.ts", "app/**/*.tsx", "app.config.ts"]
    },
    "apps/control-panel": {
      "entry": [
        "app/**/route.ts",
        "playwright.global-setup.ts",
        "tests/**/*.spec.ts"
      ],
      "playwright": false
    },
    "packages/design-system": {
      "entry": ["src/index.ts", "src/native/index.tsx"]
    }
  },
  "ignore": [
    ".kilo/worktrees/**",
    "apps/*/fingerprint.config.js",
    "services/dsh/tools/generate-types.mjs",
    "services/identity/tools/generate-types.mjs",
    "services/identity/tests/contract-guard.test.mjs",
    "tools/dev/query-knowledge.mjs",
    "tools/mobile/define-samrim-expo-app.d.cts",
    "tools/mobile/with-android-development-client.d.cts",
    "tools/dev/runtime-proof/trusted-executables.d.mts"
  ],
  "ignoreBinaries": [
    "build",
    "go",
    "playwright",
    "expo",
    "gofmt",
    "pwsh",
    "typecheck"
  ]
}
