{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/dev/check-encoding.mjs",
        "tools/dev/check-finance-surface-auth.mjs",
        "tools/dev/check-openapi.mjs",
        "tools/dev/check-typescript-ast-tests.mjs",
        "tools/dev/payment-provider-mock.mjs",
        "tools/dev/sync-lenovo-source.mjs",
        "tools/go/format-check.mjs",
        "tools/mobile/check-android-expo-readiness.mjs",
        "tools/mobile/export-mobile-smoke.mjs",
        "tools/mobile/hash-mobile-secret-input.mjs",
        "tools/dev/trusted-executables.mjs",
        "tools/dev/trusted-executables.d.mts"
      ]
    },
    "apps/app-captain": {
      "entry": [
        "app/**/*.tsx"
      ]
    },
    "apps/app-client": {
      "entry": [
        "app/**/*.tsx",
        "tests/**/*.e2e.cjs",
        "tests/**/*.manual.mjs"
      ]
    },
    "apps/app-partner": {
      "entry": [
        "app/**/*.tsx",
        "tests/**/*.e2e.cjs",
        "tests/**/*-session-probe.cjs"
      ]
    },
    "apps/control-panel": {
      "entry": [
        "hash-secret-input.mjs",
        "app/**/route.ts",
        "tests/**/*.e2e.cjs"
      ]
    }
  },
  "ignore": [
    "apps/*/fingerprint.config.js",
    "services/dsh/tools/generate-types.mjs",
    "services/identity/tools/generate-types.mjs",
    "tools/mobile/define-samrim-expo-app.d.cts"
  ],
  "ignoreBinaries": [
    "build",
    "go",
    "expo",
    "gofmt",
    "pwsh",
    "typecheck"
  ]
}
