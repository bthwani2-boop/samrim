{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/dev/js-deps.mjs",
        "tools/dev/verify-local-world.mjs",
        "tools/dev/verify-dsh-location-runtime.mjs",
        "tools/mobile/export-mobile-smoke.mjs",
        "tools/mobile/test-mobile-app.mjs"
      ]
    },
    "apps/control-panel": {
      "entry": [
        "app/**/route.ts",
        "playwright.global-setup.ts",
        "tests/**/*.spec.ts"
      ],
      "playwright": false
    }
  },
  "ignore": [
    // Expo/EAS host projections are loaded by Expo's config and fingerprint tooling.
    "apps/*/fingerprint.config.js",
    // These are explicit Nx/Identity command entrypoints, not import-graph modules.
    "services/dsh/tools/generate-types.mjs",
    "services/identity/tools/generate-types.mjs",
    "services/identity/tests/contract-guard.test.mjs",
    // This is a documented manual knowledge-query entrypoint.
    "tools/dev/query-knowledge.mjs",
    "tools/mobile/define-samrim-expo-app.d.cts",
    "tools/mobile/with-android-development-client.d.cts"
  ],
  "ignoreDependencies": [
    "expo",
    // These native capability declarations are intentionally retained in the
    // mobile manifests; Knip's JS graph cannot observe native/config consumers.
    "expo-document-picker",
    "expo-file-system",
    "expo-font",
    "expo-haptics",
    "expo-image",
    "expo-image-manipulator",
    "expo-image-picker",
    "expo-keep-awake",
    "expo-location",
    "expo-network",
    "expo-notifications",
    "expo-task-manager",
    "react-native-keyboard-controller",
    "react-native-maps"
  ],
  "ignoreBinaries": [
    // CI, Nx project targets and developer-host binaries are resolved outside the JS graph.
    "build",
    "playwright",
    // Expo is the host binary used by the mobile export projection.
    "expo",
    "gofmt",
    "pwsh",
    "typecheck"
  ]
}
