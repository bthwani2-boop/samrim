{
  "name": "@bthwani/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./theme": "./src/theme/index.ts",
    "./native": "./src/native/index.tsx",
    "./theme.css": "./theme.css",
    "./web": "./src/web/index.ts",
    "./web.css": "./web.css",
    "./native/map": {
      "types": "./src/native/map.tsx",
      "react-native": "./src/native/map.tsx",
      "browser": "./src/native/map.web.tsx",
      "default": "./src/native/map.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "theme:generate": "node --loader ./tools/ts-resolver.mjs tools/generate-theme-css.mjs",
    "theme:check": "node --loader ./tools/ts-resolver.mjs tools/verify-theme-authority.mjs"
  },
  "dependencies": {
    "@expo/material-symbols": "0.1.1",
    "leaflet": "1.9.4"
  },
  "peerDependencies": {
    "@expo/ui": "57.0.26",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2"
  },
  "devDependencies": {
    "@expo/ui": "57.0.26",
    "@types/leaflet": "1.9.21",
    "@types/react": "19.2.17",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@expo/ui": {
      "optional": true
    },
    "react-native-maps": {
      "optional": true
    }
  }
}
