{
  "name": "@bthwani/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/semantics/themes.ts",
    "./theme.css": "./theme.css",
    "./web/css-projection": "./src/web/css-projection.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "theme:check": "node --loader ./tools/ts-resolver.mjs tools/generate-theme-css.mjs --check",
    "theme:verify": "node --loader ./tools/ts-resolver.mjs tools/verify-theme-authority.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
