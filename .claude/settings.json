{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/dev/agent-execution-guard.mjs",
              "session-start",
              "--host",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/dev/agent-execution-guard.mjs",
              "pre-tool",
              "--host",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/dev/agent-execution-guard.mjs",
              "subagent-start",
              "--host",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
