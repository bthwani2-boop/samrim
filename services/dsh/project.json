{
  "name": "dsh",
  "root": "services/dsh",
  "projectType": "application",
  "targets": {
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node services/dsh/tools/generate-types.mjs --check"
      },
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node --version"
        },
        {
          "runtime": "pnpm --version"
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome lint services/dsh --diagnostic-level=error"
      }
    }
  },
  "tags": [
    "scope:dsh",
    "type:service"
  ]
}
