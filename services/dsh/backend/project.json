{
  "name": "dsh-backend",
  "root": "services/dsh/backend",
  "projectType": "application",
  "implicitDependencies": [
    "@bthwani/dsh"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "goToolchain"
      ],
      "options": {
        "command": "go build ./...",
        "cwd": "services/dsh/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "goToolchain"
      ],
      "options": {
        "command": "node tools/dev/check-go.mjs --quick --module=dsh",
        "cwd": "."
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "goToolchain"
      ],
      "options": {
        "command": "go vet ./...",
        "cwd": "services/dsh/backend"
      }
    }
  },
  "tags": [
    "scope:dsh",
    "type:go-backend"
  ]
}
