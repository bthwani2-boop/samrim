{
  "name": "dsh-backend",
  "root": "services/dsh/backend",
  "projectType": "application",
  "implicitDependencies": [
    "dsh",
    "dsh-database",
    "identity-go-client"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "go build ./...",
        "cwd": "services/dsh/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "go test ./...",
        "cwd": "services/dsh/backend"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "go vet ./...",
        "cwd": "services/dsh/backend"
      }
    }
  },
  "tags": [
    "scope:dsh-backend",
    "type:service"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ]
  }
}
