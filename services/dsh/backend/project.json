{
  "name": "dsh-backend",
  "root": "services/dsh/backend",
  "projectType": "application",
  "implicitDependencies": [
    "dsh",
    "identity-go-client",
    "wlt"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default", "goToolchain"],
      "options": {"command": "go build ./...", "cwd": "services/dsh/backend"}
    },
    "vet": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default", "goToolchain"],
      "options": {"command": "go vet ./...", "cwd": "services/dsh/backend"}
    },
    "unit": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default", "goToolchain"],
      "options": {"command": "go test ./...", "cwd": "services/dsh/backend"}
    },
    "contract": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default"],
      "options": {"command": "pnpm --dir services/wlt contract:conformance"}
    },
    "baseline-proof": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {"command": "node tests/runtime/verify-dsh-baseline.mjs --env-file=infra/local/.env"}
    },
    "runtime-proof": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {"command": "node tests/runtime/verify-dsh-runtime-core.mjs --env-file=infra/local/.env"}
    },
    "location-proof": {
      "cache": false,
      "executor": "nx:run-commands",
      "inputs": ["default", "{workspaceRoot}/tests/runtime/verify-dsh-location-runtime.mjs"],
      "options": {"command": "node tests/runtime/verify-dsh-location-runtime.mjs --env-file=infra/local/.env"}
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {"command": "node tools/go/format-check.mjs services/dsh/backend"}
    }
  },
  "tags": ["scope:dsh-backend", "type:service"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "{workspaceRoot}/go.work", "{workspaceRoot}/go.work.sum"]
  }
}
