{
  "name": "dsh-backend",
  "root": "services/dsh/backend",
  "projectType": "application",
  "implicitDependencies": [
    "dsh",
    "dsh-database",
    "identity-go-client"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "goToolchain"
      ],
      "options": {
        "command": "go build ./...",
        "cwd": "services/dsh/backend"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "goToolchain"
      ],
      "options": {
        "command": "go vet ./...",
        "cwd": "services/dsh/backend"
      }
    },
    "unit": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "goToolchain"
      ],
      "options": {
        "command": "go test ./...",
        "cwd": "services/dsh/backend"
      }
    },
    "baseline-proof": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/verify-dsh-baseline.mjs --env-file=infra/local/.env"
      },
      "dependsOn": [
        {
          "projects": [
            "identity-backend"
          ],
          "target": "migration-proof"
        }
      ]
    },
    "runtime-proof": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/verify-dsh-runtime-core.mjs --env-file=infra/local/.env"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/check-go-format.mjs services/dsh/backend"
      }
    },
    "ci-image": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/build-ci-image.mjs dsh"
      }
    }
  },
  "tags": [
    "scope:dsh-backend",
    "type:service"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ]
  }
}
