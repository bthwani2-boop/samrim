{
  "name": "@bthwani/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "clients/index.ts",
  "types": "clients/index.ts",
  "exports": {
    ".": "./clients/index.ts",
    "./server": "./clients/identity-client.ts",
    "./session-policy": "./clients/identity-session-policy.ts",
    "./secure-random": "./clients/secure-random.ts"
  },
  "scripts": {
    "openapi:generate": "openapi-typescript contracts/identity.openapi.yaml -o clients/generated/identity-api.ts",
    "typecheck": "pnpm run openapi:generate && tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "openapi-typescript": "7.13.0",
    "react": "19.2.3",
    "typescript": "6.0.2"
  }
}
