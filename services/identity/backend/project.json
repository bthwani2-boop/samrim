{
  "name": "identity-backend",
  "root": "services/identity/backend",
  "projectType": "application",
  "implicitDependencies": [
    "identity"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "goToolchain"
      ],
      "options": {
        "command": "go build ./...",
        "cwd": "services/identity/backend"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "goToolchain"
      ],
      "options": {
        "command": "go vet ./...",
        "cwd": "services/identity/backend"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/go/format-check.mjs services/identity/backend"
      }
    }
  },
  "tags": [
    "scope:identity-backend",
    "type:service"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ]
  }
}
