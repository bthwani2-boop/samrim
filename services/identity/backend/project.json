{
  "name": "identity-backend",
  "root": "services/identity/backend",
  "projectType": "application",
  "implicitDependencies": [
    "identity",
    "identity-database"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "goToolchain"
      ],
      "options": {
        "command": "go build ./...",
        "cwd": "services/identity/backend"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "goToolchain"
      ],
      "options": {
        "command": "go vet ./...",
        "cwd": "services/identity/backend"
      }
    },
    "unit": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "goToolchain"
      ],
      "options": {
        "command": "go test ./...",
        "cwd": "services/identity/backend"
      }
    },
    "migration-proof": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/verify-identity-migrations.mjs --env-file=infra/local/.env"
      },
      "dependsOn": [
        {
          "projects": [
            "control-panel"
          ],
          "target": "browser-live-proof"
        }
      ]
    },
    "runtime-proof": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/verify-identity-runtime.mjs --env-file=infra/local/.env"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/check-go-format.mjs services/identity/backend"
      }
    },
    "ci-image": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/build-ci-image.mjs identity"
      }
    }
  },
  "tags": [
    "scope:identity-backend",
    "type:service"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ]
  }
}
