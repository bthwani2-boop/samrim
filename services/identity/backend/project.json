{
  "name": "identity-backend",
  "root": "services/identity/backend",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "goToolchain"
      ],
      "options": {
        "command": "go build ./...",
        "cwd": "services/identity/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "goToolchain"
      ],
      "options": {
        "command": "node tools/dev/check-go.mjs --quick --module=identity",
        "cwd": "."
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "goToolchain"
      ],
      "options": {
        "command": "go vet ./...",
        "cwd": "services/identity/backend"
      }
    }
  },
  "tags": [
    "scope:identity",
    "type:go-backend"
  ]
}
