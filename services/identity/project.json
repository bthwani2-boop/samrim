{
  "name": "identity",
  "root": "services/identity",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build ./...",
        "cwd": "services/identity/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./... && node ../tools/generate-types.mjs --check && node ../tests/contract-guard.test.mjs",
        "cwd": "services/identity/backend"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go vet ./...",
        "cwd": "services/identity/backend"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p services/identity/tsconfig.json"
      }
    }
  },
  "tags": [
    "scope:identity",
    "type:service"
  ]
}
