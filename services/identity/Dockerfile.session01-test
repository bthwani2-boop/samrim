# Test-only pinned builder; never used as a deployable Identity image.
FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf
ENV GOTOOLCHAIN=local GOWORK=off CGO_ENABLED=0
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download && go mod verify
COPY backend/cmd/ ./cmd/
COPY backend/internal/ ./internal/
COPY database/migrations/ /database/migrations/
