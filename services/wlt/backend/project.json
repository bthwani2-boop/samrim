{
  "name": "wlt-backend",
  "root": "services/wlt/backend",
  "projectType": "application",
  "implicitDependencies": ["@bthwani/wlt", "@bthwani/identity"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "goToolchain"],
      "options": {
        "command": "node tools/dev/check-go.mjs --quick --module=wlt",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:wlt", "type:go-backend"]
}
