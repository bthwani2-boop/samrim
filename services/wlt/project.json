{
  "name": "wlt",
  "root": "services/wlt",
  "projectType": "application",
  "tags": [
    "scope:wlt",
    "type:service"
  ],
  "targets": {
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev/check-openapi.mjs wlt"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/dev/check-openapi.mjs",
        {
          "runtime": "node --version"
        },
        {
          "runtime": "pnpm --version"
        }
      ]
    }
  }
}
