SAMRIM_POSTGRES_USER=samrim_local
SAMRIM_POSTGRES_PASSWORD=change-me-local-only
SAMRIM_POSTGRES_DB=samrim_local

SAMRIM_MAILPIT_WEB_PORT=18026
SAMRIM_MEDIA_PORT=18333

SAMRIM_IDENTITY_PORT=18082
SAMRIM_DSH_PORT=18080
SAMRIM_WLT_PORT=18083
SAMRIM_CONTROL_PORT=13000

SAMRIM_APP_CLIENT_METRO_PORT=18101
SAMRIM_APP_PARTNER_METRO_PORT=18102
SAMRIM_APP_CAPTAIN_METRO_PORT=18103
SAMRIM_APP_FIELD_METRO_PORT=18104

BTHWANI_ENV=development

# Existing real local actors used only by the development-session shortcut.
# Populate these with actor_id values created/enrolled through canonical Identity flows.
IDENTITY_DEVELOPMENT_CLIENT_ACTOR_ID=
IDENTITY_DEVELOPMENT_PARTNER_ACTOR_ID=
IDENTITY_DEVELOPMENT_CAPTAIN_ACTOR_ID=
IDENTITY_DEVELOPMENT_FIELD_ACTOR_ID=
IDENTITY_DEVELOPMENT_OPERATOR_ACTOR_ID=

DSH_MEDIA_ACCESS_KEY=samrim-media
DSH_MEDIA_SECRET_KEY=change-me-media-local-only
DSH_MEDIA_BUCKET=samrim-catalog-media
DSH_MEDIA_MAX_BYTES=10485760

IDENTITY_CHALLENGE_HMAC_SECRET=local-identity-challenge-hmac-secret-2026
IDENTITY_DSH_SERVICE_TOKEN=local-dsh-identity-service-token-2026
CONTROL_PANEL_SERVICE_TOKEN=local-control-panel-service-token-2026
WLT_DSH_SERVICE_TOKEN=local-wlt-dsh-service-token-2026
# Set a unique 32-byte base64/hex key outside development; development derives a local key from WLT_DSH_SERVICE_TOKEN.
WLT_DESTINATION_ENCRYPTION_KEY=
# Base64-encoded 32-byte keys, keyed by immutable IDs. Keep prior IDs while pending proofs or completion retries reference them.
DSH_DELIVERY_PROOF_ACTIVE_KEY_ID=local-v1
DSH_DELIVERY_PROOF_KEYRING={"local-v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
IDENTITY_ABUSE_HMAC_SECRET=replace-with-a-different-32-byte-secret
OPERATOR_BOOTSTRAP_SECRET=replace-with-a-one-time-32-byte-secret
IDENTITY_RETENTION_CHALLENGE_DAYS=30
IDENTITY_RETENTION_PASSWORD_ATTEMPT_DAYS=30
IDENTITY_RETENTION_OPERATOR_ENROLLMENT_DAYS=30
IDENTITY_RETENTION_SESSION_DAYS=90
IDENTITY_RETENTION_AUDIT_DAYS=365
IDENTITY_RETENTION_BATCH_SIZE=500
IDENTITY_TRUSTED_PROXY_IPS=
IDENTITY_API_BASE_URL=http://127.0.0.1:18082
DSH_API_BASE_URL=http://127.0.0.1:18080
DSH_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:18080/dsh/catalog/media
EXPO_PUBLIC_IDENTITY_API_URL=http://127.0.0.1:18082
EXPO_PUBLIC_DSH_API_URL=http://127.0.0.1:18080
CONTROL_PANEL_PUBLIC_ORIGIN=http://localhost:13000
IDENTITY_WEBAUTHN_RP_ID=localhost
IDENTITY_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:13000
IDENTITY_CHALLENGE_DELIVERY_MODE=mailpit
IDENTITY_MAILPIT_RECIPIENT=identity-dev@samrim.local
IDENTITY_CORS_ALLOWED_ORIGINS=http://localhost:13000
