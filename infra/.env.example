# Isolated development only. Generate actual base secrets with tools/dev/setup-env.mjs.
# Empty required values must be explicitly provisioned; never use this as a live secret file.
# Base PostgreSQL
REF_POSTGRES_USER=bthwani_refoundation_admin
REF_POSTGRES_DB=bthwani_refoundation
REF_POSTGRES_PASSWORD=

# Local media credentials and bucket
REF_MEDIA_ACCESS_KEY=
REF_MEDIA_SECRET_KEY=
REF_MEDIA_BUCKET=bthwani-refoundation-media

# DSH dedicated database and committed image selection
REF_DSH_RUNTIME_DATABASE=
REF_DSH_RUNTIME_USER=
REF_DSH_RUNTIME_PASSWORD=
REF_DSH_DISCOVERY_SCHEMA=
REF_DSH_PUBLIC_CORS_ORIGINS=
REF_DSH_IMAGE_TAG=dev
# Bootstrap credentials are supplied only for an explicit isolated bootstrap.
REF_DSH_BOOTSTRAP_USER=
REF_DSH_BOOTSTRAP_PASSWORD=
REF_DSH_ENABLE_ISOLATED_CUSTOMER_CART=false
REF_DSH_ENABLE_ISOLATED_EMPLOYEES=false
REF_DSH_ENABLE_ISOLATED_MERCHANT_STANDING=false
REF_DSH_ENABLE_ISOLATED_STORE_AVAILABILITY=false
REF_DSH_ENABLE_ISOLATED_CAPTAIN_STANDING=false
REF_DSH_ENABLE_ISOLATED_CAPTAIN_INTEREST=false
REF_DSH_PRIVATE_TLS_CERT=
REF_DSH_PRIVATE_TLS_KEY=

# Identity dedicated database and synthetic capability admission
REF_IDENTITY_RUNTIME_DATABASE_URL=
REF_IDENTITY_TEST_SCHEMA=
REF_IDENTITY_IMAGE_TAG=dev
REF_IDENTITY_CAPTAIN_ADMISSION=false
REF_IDENTITY_SYNTHETIC_PHONE_AUTH=false
REF_IDENTITY_SYNTHETIC_YEMEN_PHONES=+967770000001
REF_IDENTITY_SYNTHETIC_PHONE_HMAC_KEY=
REF_IDENTITY_OPERATOR_PASSKEY_AUTH=false
REF_IDENTITY_OPERATOR_BOOTSTRAP=false
REF_IDENTITY_LOCAL_DEV_FIRST_OPERATOR=false
REF_IDENTITY_OPERATOR_PERMISSION_ADMIN=false
REF_IDENTITY_OPERATOR_PASSKEY_RPID=
REF_IDENTITY_OPERATOR_PASSKEY_ORIGINS=

# WLT dedicated read-only runtime (never a sandbox writer or administrator)
REF_WLT_TEST_DATABASE_URL=
REF_WLT_IMAGE_TAG=dev
