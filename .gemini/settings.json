{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "bthwani-agent-execution-guard-session",
            "type": "command",
            "command": "node \"${GEMINI_PROJECT_DIR}/tools/dev/agent-execution-guard.mjs\" session-start --host gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "bthwani-agent-execution-guard-before-agent",
            "type": "command",
            "command": "node \"${GEMINI_PROJECT_DIR}/tools/dev/agent-execution-guard.mjs\" before-agent --host gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "bthwani-agent-execution-guard-tool",
            "type": "command",
            "command": "node \"${GEMINI_PROJECT_DIR}/tools/dev/agent-execution-guard.mjs\" pre-tool --host gemini",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
