{
  "name": "samrim",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "client": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/open-mobile-apps.ps1 -App app-client",
    "partner": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/open-mobile-apps.ps1 -App app-partner",
    "captain": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/open-mobile-apps.ps1 -App app-captain",
    "field": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/open-mobile-apps.ps1 -App app-field",
    "scr": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/scrcpy.ps1",
    "mobile:verify-config": "node tools/mobile/verify-mobile-config.mjs",
    "brand:check": "node tools/mobile/verify-brand-assets.mjs",
    "control": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Control",
    "identity:blocklist:generate": "node services/identity/tools/generate-password-blocklist.mjs",
    "identity:blocklist:check": "node services/identity/tools/generate-password-blocklist.mjs --check",
    "dsh:import-catalog-products": "node services/dsh/tools/import-catalog-products.mjs",
    "runtime:up": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Up",
    "runtime:down": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Down",
    "runtime:restart": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Restart",
    "runtime:status": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Status",
    "runtime:logs": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Logs",
    "runtime:doctor": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Doctor",
    "runtime:reset": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Reset",
    "runtime:purge": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Purge",
    "runtime:rebuild": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action Rebuild",
    "runtime:restart-service": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action RestartService",
    "runtime:logs-service": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime.ps1 -Action LogsService",
    "world:ensure": "node tools/dev/local-world.mjs --ensure",
    "world:status": "node tools/dev/local-world.mjs --status",
    "runtime:verify-ownership": "node tools/dev/verify-local-runtime-ownership.mjs",
    "bootstrap": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/bootstrap.ps1",
    "safe:push": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/safe-push.ps1",
    "theme:generate": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/generate-theme-css.mjs",
    "theme:check": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/generate-theme-css.mjs --check",
    "theme:verify": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/verify-theme-authority.mjs",
    "verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/verify-local-candidate.ps1",
    "mobile:prepare": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/prepare-local-development.ps1"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1",
      "decode-uri-component": "0.5.0",
      "nx>smol-toml": "1.8.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "knip": "6.34.0",
    "nx": "23.2.0",
    "typescript": "6.0.2"
  }
}
