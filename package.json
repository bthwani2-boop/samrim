{
  "name": "samrim",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "mobile:verify-config": "node tools/mobile/verify-mobile-config.mjs",
    "mobile:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/build-development.ps1",
    "mobile:test-credential-atomicity": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/test-build-development.ps1",
    "brand:check": "node tools/mobile/verify-brand-assets.mjs",
    "identity:blocklist:generate": "node services/identity/tools/generate-password-blocklist.mjs",
    "identity:blocklist:check": "node services/identity/tools/generate-password-blocklist.mjs --check",
    "dsh:import-catalog-products": "node services/dsh/tools/import-catalog-products.mjs",
    "runtime:up": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/dev.ps1 up",
    "runtime:down": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/dev.ps1 down",
    "runtime:status": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/dev.ps1 status",
    "world:ensure": "node tools/dev/local-world.mjs --ensure",
    "world:status": "node tools/dev/local-world.mjs --status",
    "runtime:verify-ownership": "node tools/dev/verify-local-runtime-ownership.mjs",
    "bootstrap": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/bootstrap.ps1",
    "safe:push": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/safe-push.ps1",
    "theme:generate": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/generate-theme-css.mjs",
    "theme:check": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/generate-theme-css.mjs --check",
    "theme:verify": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/verify-theme-authority.mjs",
    "verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/verify-local-candidate.ps1",
    "mobile:prepare": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/prepare-local-development.ps1",
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/dev.ps1 daily"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1",
      "decode-uri-component": "0.5.0",
      "nx>smol-toml": "1.8.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "knip": "6.34.0",
    "nx": "23.2.0",
    "typescript": "6.0.2"
  }
}
