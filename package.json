{
  "name": "samrim",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "client": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/start-mobile-runtime.ps1 -App app-client",
    "partner": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/start-mobile-runtime.ps1 -App app-partner",
    "captain": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/start-mobile-runtime.ps1 -App app-captain",
    "field": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/start-mobile-runtime.ps1 -App app-field",
    "scr": "scrcpy --tcpip",
    "mobile:verify-config": "node tools/mobile/verify-mobile-config.mjs",
    "brand:check": "node tools/mobile/verify-brand-assets.mjs",
    "control": "pnpm --dir apps/control-panel dev",
    "dsh": "nx run dsh:serve",
    "identity": "nx run identity:serve",
    "nx:projects": "nx show projects",
    "workspace:typecheck": "nx run-many -t typecheck --all --outputStyle=stream",
    "workspace:test": "nx run-many -t test --all --outputStyle=stream",
    "workspace:build": "nx run-many -t build --all --outputStyle=stream",
    "workspace:mobile-export-smoke": "nx run-many -t export-smoke --projects=app-captain,app-client,app-field,app-partner --outputStyle=stream",
    "workspace:vet": "nx run-many -t vet --all --outputStyle=stream",
    "workspace:verify": "pnpm run workspace:typecheck && pnpm run workspace:test && pnpm run workspace:build && pnpm run workspace:mobile-export-smoke && pnpm run workspace:vet",
    "quality:lint": "biome lint apps packages services tools --diagnostic-level=error",
    "runtime:daily:config": "docker compose --env-file infra/local/compose/.env -f infra/local/compose/compose.yaml config --quiet",
    "runtime:daily:up": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/local-runtime.ps1 -Action Up",
    "runtime:daily:down": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/local-runtime.ps1 -Action Down",
    "runtime:status": "docker compose --env-file infra/local/compose/.env -f infra/local/compose/compose.yaml --profile integration ps -a",
    "runtime:logs": "docker compose --env-file infra/local/compose/.env -f infra/local/compose/compose.yaml --profile integration logs -f",
    "runtime:verify-ownership": "node tools/dev/verify-local-runtime-ownership.mjs",
    "doctor": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/doctor.ps1",
    "bootstrap": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/bootstrap.ps1",
    "safe:push": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/safe-push.ps1",
    "nx:verify-tags": "node tools/dev/verify-nx-project-tags.mjs",
    "docs:verify-command-parity": "node tools/dev/verify-doc-command-parity.mjs",
    "knowledge:verify": "node tools/dev/verify-knowledge-system.mjs",
    "repository:verify-structure": "node tools/dev/verify-repository-structure.mjs",
    "repository:verify-hygiene": "node tools/dev/verify-structural-hygiene.mjs",
    "repository:verify-liveness": "knip --no-progress --reporter compact --no-config-hints",
    "knowledge:query": "node tools/dev/query-knowledge.mjs",
    "knowledge:verify-agent-contract": "node tools/dev/verify-agent-knowledge-contract.mjs",
    "knowledge:verify-references": "node tools/dev/verify-knowledge-references.mjs",
    "knowledge:verify:all": "pnpm run knowledge:verify && pnpm run knowledge:verify-references && pnpm run knowledge:verify-agent-contract",
    "docs:verify-config-parity": "node tools/dev/verify-doc-config-parity.mjs",
    "docs:verify:all": "pnpm run docs:verify-command-parity && pnpm run docs:verify-config-parity",
    "runtime:integration:close": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/integration-proof.ps1",
    "theme:generate": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/generate-theme-css.mjs",
    "theme:check": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/generate-theme-css.mjs --check",
    "theme:verify": "node --loader ./tools/dev/ts-resolver.mjs tools/dev/verify-theme-authority.mjs",
    "candidate:local:verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/verify-local-candidate.ps1",
    "knowledge:sync": "node tools/dev/knowledge-source.mjs",
    "mobile:prepare": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/prepare-local-development.ps1"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1",
      "decode-uri-component": "0.5.0",
      "nx>smol-toml": "1.8.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "knip": "6.34.0",
    "nx": "23.2.0",
    "typescript": "6.0.2"
  }
}
