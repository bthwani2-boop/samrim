{
  "name": "samrim",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "mobile:verify-config": "node tools/mobile/verify-mobile-config.mjs",
    "mobile:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/build-development.ps1",
    "mobile:test-credential-atomicity": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/test-build-development.ps1",
    "brand:check": "node tools/mobile/verify-brand-assets.mjs",
    "identity:blocklist:generate": "node services/identity/tools/generate-password-blocklist.mjs",
    "identity:blocklist:check": "node services/identity/tools/generate-password-blocklist.mjs --check",
    "dsh:import-catalog-products": "node services/dsh/tools/import-catalog-products.mjs",
    "bootstrap": "pnpm install --frozen-lockfile && go work sync",
    "check": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/check-local.ps1",
    "theme:generate": "pnpm --dir packages/design-system theme:generate",
    "theme:check": "pnpm --dir packages/design-system theme:check",
    "theme:verify": "pnpm theme:check",
    "verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/check-local.ps1 -Candidate",
    "safe:push": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/safe-push.ps1",
    "mobile:prepare": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/mobile/prepare-local-development.ps1",
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/dev.ps1",
    "client": "pnpm --dir apps/app-client dev",
    "partner": "pnpm --dir apps/app-partner dev",
    "captain": "pnpm --dir apps/app-captain dev",
    "field": "pnpm --dir apps/app-field dev",
    "control": "pnpm --dir apps/control-panel dev",
    "scr": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dev/scr.ps1",
    "test:mobile-shared-coverage": "node --test tools/mobile/test-mobile-app-coverage.test.mjs tools/mobile/test-mobile-app-coverage-partner.test.mjs tools/mobile/test-mobile-app-coverage-captain.test.mjs tools/mobile/test-mobile-app-coverage-field.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1",
      "decode-uri-component": "0.5.0",
      "nx>smol-toml": "1.8.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@expo/metro-config": "57.0.12",
    "expo": "57.0.27",
    "knip": "6.34.0",
    "next": "16.3.4",
    "nx": "23.2.1",
    "typescript": "6.0.2"
  }
}
