{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "plugins": [],
  "analytics": false,
  "targetDefaults": {
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node --version"
        },
        {
          "runtime": "pnpm --version"
        }
      ]
    },
    "unit": {
      "cache": true
    },
    "contract": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node --version"
        },
        {
          "runtime": "pnpm --version"
        }
      ]
    },
    "build": {
      "cache": true
    },
    "export-smoke": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/mobile/export-mobile-smoke.mjs",
        "{workspaceRoot}/tools/mobile/define-samrim-expo-app.cjs",
        {
          "runtime": "node --version"
        },
        {
          "runtime": "pnpm --version"
        }
      ]
    },
    "vet": {
      "cache": true
    }
  },
  "nxCloudId": "6aa9eedc45c07f39423ffa9f"
}
