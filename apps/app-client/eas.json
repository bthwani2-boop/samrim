{
  "cli": {
    "version": "24.7.0",
    "appVersionSource": "remote",
    "requireCommit": true,
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "node": "24.22.1",
      "pnpm": "10.34.7",
      "env": {
        "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
      }
    },
    "development": {
      "extends": "base",
      "credentialsSource": "local",
      "environment": "development",
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "extends": "base",
      "environment": "preview",
      "channel": "preview",
      "distribution": "internal",
      "ios": { "image": "latest" },
      "android": {
        "image": "latest",
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    }
  }
}
