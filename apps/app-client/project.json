{
  "name": "app-client",
  "root": "apps/app-client",
  "sourceRoot": "apps/app-client",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/app-client typecheck"
      }
    },
    "export-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/mobile/export-mobile-smoke.mjs app-client"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome lint apps/app-client --diagnostic-level=error"
      }
    }
  },
  "tags": [
    "scope:app-client",
    "type:app",
    "runtime:identity",
    "runtime:dsh"
  ]
}
