{
  "name": "control-panel",
  "root": "apps/control-panel",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/control-panel typecheck"
      },
      "outputs": [
        "{projectRoot}/.next/types"
      ],
      "inputs": [
        "default",
        "^default",
        "nodeToolchain",
        "controlPanelBuildEnvironment",
        "{workspaceRoot}/tools/dev/trusted-executables.mjs",
        "{workspaceRoot}/tools/dev/trusted-executables.d.mts"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/control-panel build"
      },
      "outputs": [
        "{projectRoot}/.next"
      ],
      "inputs": [
        "default",
        "^default",
        "nodeToolchain",
        "controlPanelBuildEnvironment"
      ]
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test apps/control-panel/tests/partner-financial-table.test.mjs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome lint apps/control-panel --diagnostic-level=error"
      }
    }
  },
  "tags": [
    "scope:control-panel",
    "type:app"
  ]
}
