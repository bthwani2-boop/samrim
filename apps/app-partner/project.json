{
  "name": "app-partner",
  "root": "apps/app-partner",
  "sourceRoot": "apps/app-partner",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/app-partner typecheck"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
