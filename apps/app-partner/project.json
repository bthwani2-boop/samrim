{
  "name": "app-partner",
  "root": "apps/app-partner",
  "sourceRoot": "apps/app-partner",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/app-partner typecheck"
      }
    },
    "export-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/mobile/export-mobile-smoke.mjs app-partner"
      }
    },
    "unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/mobile/test-mobile-app.mjs app-partner"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/mobile/test-mobile-app.mjs",
        "{workspaceRoot}/tools/mobile/define-samrim-expo-app.cjs",
        {
          "runtime": "node --version"
        },
        {
          "runtime": "pnpm --version"
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome lint apps/app-partner --diagnostic-level=error"
      }
    }
  },
  "tags": [
    "scope:app-partner",
    "type:app"
  ],
  "implicitDependencies": [
    "mobile-tooling"
  ]
}
