{
  "name": "app-partner",
  "root": "apps/app-partner",
  "sourceRoot": "apps/app-partner",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/app-partner typecheck"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test apps/app-partner/tests/actor-query-client.test.mjs apps/app-partner/tests/partner-store-invite-schema.test.mjs"
      }
    },
    "export-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/mobile/export-mobile-smoke.mjs app-partner"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome lint apps/app-partner --diagnostic-level=error"
      }
    }
  },
  "tags": [
    "scope:app-partner",
    "type:app",
    "runtime:identity",
    "runtime:dsh"
  ]
}
